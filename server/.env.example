# Copy this file to ".env" and fill in your values.
# Get an OpenAI key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED in production: secret used to sign auth tokens (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, the server uses a random per-boot secret (sessions reset on restart).
JWT_SECRET=change-me-to-a-long-random-string

# Optional overrides
OPENAI_MODEL=gpt-4o
PORT=3000

# Path to the SQLite database file. In production, point this at a mounted
# persistent volume (e.g. /data/doctor.db) so accounts survive redeploys.
DOCTOR_DB_PATH=./doctor.db

# Comma-separated browser origins allowed to call the API cross-origin.
# The dashboard is same-origin (needs no entry) and the mobile app is not a
# browser (not subject to CORS). Leave empty to deny all cross-origin browsers.
ALLOWED_ORIGINS=
